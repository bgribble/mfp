                "max_width": 600,
                "min_height": 12,
                "min_width": 12,
                "no_export": false,
                "obj_args": null,
                "obj_name": "text_062",
                "obj_state": 3,
                "obj_type": "text",
                "panel_enable": false,
                "panel_x": 55.0,
                "panel_y": 76.0,
                "panel_z": 0,
                "patch_x": 55.0,
                "patch_y": 76.0,
                "patch_z": 0,
                "position_x": 55.0,
                "position_y": 76.0,
                "position_z": 0,
                "properties": {},
                "save_in_preset": false,
                "scope": "__patch__",
                "style": {},
                "update_required": true,
                "value": "Mathematical functions can be defined in dataflow style or using the <b>[func]</b> \nbuiltin.  <b>[func]</b> will be slightly more efficient and may be clearer to read, but \nboth work fine.\n\nSay we have a number coming in and need to take that value <i>x</i> and compute the \nfunction: \n\n  y = 3*x^2 + 4*x + 5\n\nTwo ways to do it: ",
                "width": 573.0
            },
            "initargs": null,
            "midi_filters": null,
            "midi_mode": null,
            "name": "text_062",
            "osc_methods": [],
            "presets": {},
            "properties": {},
            "type": "text",
            "value": "Mathematical functions can be defined in dataflow style or using the <b>[func]</b> \nbuiltin.  <b>[func]</b> will be slightly more efficient and may be clearer to read, but \nboth work fine.\n\nSay we have a number coming in and need to take that value <i>x</i> and compute the \nfunction: \n\n  y = 3*x^2 + 4*x + 5\n\nTwo ways to do it: "
        },

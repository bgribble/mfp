                "scope": "__patch__",
                "style": {},
                "update_required": true,
                "value": "You have gotten this far, which is good news!  You know how to launch the program and open the Help menu. \n  \nIn case you forgot already: \n          <tt>mfp [options] [filename ...]</tt>   \n\nTo see a complete list of command-line options:\n          <tt>mfp --help</tt>\n\nTo see a list of all builtin objects with a brief description: \n          <tt>mfp --help-builtins</tt>",
                "width": 537.0
            },

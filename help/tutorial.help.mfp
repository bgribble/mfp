                "style": {},
                "update_required": true,
                "value": "<b>Menu bar</b>\n\nMFP is first and foremost a keyboard-driven app, but most keyboard actions have menu entries as well. Note that individual items in a patch will also have a context menu that you can pop up with the right button or two-finger click. ",
                "width": 580.0
            },

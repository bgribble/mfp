                "layername": "14: Pattern: Metronome",
                "max_width": 600,
                "min_height": 12,
                "min_width": 12,
                "no_export": false,
                "obj_args": null,
                "obj_name": "text_060",
                "obj_state": 3,
                "obj_type": "text",
                "panel_enable": false,
                "panel_x": 60.0,
                "panel_y": 91.0,
                "panel_z": 0,
                "patch_x": 60.0,
                "patch_y": 91.0,
                "patch_z": 0,
                "position_x": 60.0,
                "position_y": 91.0,
                "position_z": 0,
                "properties": {},
                "save_in_preset": false,
                "scope": "__patch__",
                "style": {},
                "update_required": true,
                "value": "If you want things to happen in a rhythm, you can use a <b>[metro]</b> \nto do it.  <b>[metro]</b> outputs a Bang periodically.  The interval between \nBangs is specified either in the init args or on the right inlet, in milliseconds \nin either case.  The metronome is started with a True or Bang on its left inlet\nand stopped with a False.",
                "width": 537.0
            },
            "initargs": null,
            "midi_filters": null,
            "midi_mode": null,
            "name": "text_060",
            "osc_methods": [],
            "presets": {},
            "properties": {},
            "type": "text",
            "value": "If you want things to happen in a rhythm, you can use a <b>[metro]</b> \nto do it.  <b>[metro]</b> outputs a Bang periodically.  The interval between \nBangs is specified either in the init args or on the right inlet, in milliseconds \nin either case.  The metronome is started with a True or Bang on its left inlet\nand stopped with a False."
        },

                "save_in_preset": false,
                "scope": "__patch__",
                "style": {},
                "update_required": true,
                "value": "To work through the rest of this tutorial, it will be helpful to have an empty patch to work with.  If you open the <b>File</b> menu, you will see the entry \"New\" with the key equivalent <b>C-f</b>.  <b>C-f</b> means Control-f.  Similarly, A- means Alt, S- means Shift, W- means the Windows key, M1 means first mouse button.  ",
                "width": 582.0
            },
            "initargs": null,
            "midi_filters": null,
            "midi_mode": null,
            "name": "text_014",
            "osc_methods": [],

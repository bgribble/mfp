        "50": {
            "connections": [
                []
            ],
            "do_onload": false,
            "gui_params": {
                "clickchange": false,
                "code": null,
                "connection_info": [],
                "debug": false,
                "default": "",
                "display_type": "text",
                "export_offset_x": 0,
                "export_offset_y": 0,
                "height": 78.0,
                "is_export": false,
                "layername": "9. Pattern: Sequencing",
                "max_width": 600,
                "min_height": 12,
                "min_width": 12,
                "no_export": false,
                "obj_args": null,
                "obj_name": "text_012",
                "obj_state": 3,
                "obj_type": "text",
                "panel_enable": false,
                "panel_x": 65.0,
                "panel_y": 76.0,
                "panel_z": 0,
                "patch_x": 65.0,
                "patch_y": 76.0,
                "patch_z": 0,
                "position_x": 65.0,
                "position_y": 76.0,
                "position_z": 0,
                "properties": {},
                "save_in_preset": false,
                "scope": "__patch__",
                "style": {},
                "update_required": true,
                "value": "Think of a patch as a graph where messages are passed between nodes \n<i>depth first</i> and outputs of a processor (generally) occur \nin <i>right to left</i> order.   The <b>[trigger]</b> object does nothing \nexcept repeat its input to multiple outputs in right-to-left order.",
                "width": 486.0
            },
            "initargs": null,
            "midi_filters": null,
            "midi_mode": null,
            "name": "text_012",
            "osc_methods": [],
            "presets": {},
            "properties": {},
            "type": "text",
            "value": "Think of a patch as a graph where messages are passed between nodes \n<i>depth first</i> and outputs of a processor (generally) occur \nin <i>right to left</i> order.   The <b>[trigger]</b> object does nothing \nexcept repeat its input to multiple outputs in right-to-left order."
        },
